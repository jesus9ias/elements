# infra/.env — copy to infra/.env and populate. NEVER commit the real .env.
# All values are environment-specific / sensitive and are read only via lib/config.ts.

# AWS account & region the SiteStack is deployed into.
AWS_ACCOUNT_ID=000000000000
AWS_REGION=eu-west-1

# ACM certificate for the site domain. MUST live in us-east-1 (CloudFront requirement),
# regardless of AWS_REGION above. Referenced by ARN — this stack does not create it.
AWS_CERTIFICATE_ARN=arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000

# Existing Route53 hosted zone (referenced, not created by this stack).
ROUTE53_HOSTED_ZONE_ID=Z0000000000000000000
# Apex/registered domain that owns the hosted zone above.
ROUTE53_DOMAIN=example.com
# Subdomain label the site is published under -> SUBDOMAIN.ROUTE53_DOMAIN
SUBDOMAIN=elements
