{
  "name": "@elements/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK v2 stack that publishes the Elements frontend to a subdomain",
  "bin": {
    "infra": "bin/infra.ts"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "bootstrap": "node scripts/cdk.mjs bootstrap",
    "synth": "node scripts/cdk.mjs synth",
    "diff": "node scripts/cdk.mjs diff",
    "deploy": "node scripts/cdk.mjs deploy",
    "destroy": "node scripts/cdk.mjs destroy",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
